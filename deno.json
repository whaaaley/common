{
  "name": "@whaaaley/common",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    "./safe": "./src/safe.ts",
    "./pluralize": "./src/pluralize.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      ".zed/",
      ".github/"
    ]
  },
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test -A",
    "test:node": "node --test 'src/**/*.test.ts'",
    "test:bun": "bun test src/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "lint": {
    "rules": {
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-explicit-any",
        "no-non-null-assertion"
      ]
    }
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "*.md",
      "**/*.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
