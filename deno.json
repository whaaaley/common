{
  "name": "@whaaaley/common",
  "version": "0.3.3",
  "license": "MIT",
  "exports": {
    "./safe": "./src/safe.ts",
    "./pluralize": "./src/pluralize.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      ".zed/",
      ".github/",
      ".oxlintrc.json",
      "tools/"
    ]
  },
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno task lint:deno && deno task lint:oxlint",
    "lint:deno": "deno lint",
    "lint:oxlint": "deno run -A npm:oxlint@1.78.0 src tools",
    "lint:fix": "deno run -A npm:oxlint@1.78.0 src tools --fix"
  },
  "lint": {
    "rules": {
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-explicit-any",
        "no-non-null-assertion"
      ]
    }
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "*.md",
      "**/*.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@whaaaley/git-going": "jsr:@whaaaley/git-going@0",
    "@whaaaley/looks-good": "jsr:@whaaaley/looks-good@0"
  }
}
